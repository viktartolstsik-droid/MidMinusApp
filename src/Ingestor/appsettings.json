{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "WeakApp": {
    "BaseUrl": "http://localhost:8080",
    "ApiKey": "",
    "Timeout": "00:00:45"
  },
  "Polling": {
    "Interval": "00:00:10"
  }
}
